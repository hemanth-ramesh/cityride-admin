# ==============================================================================
# CITYRIDE ADMIN OPERATIONS CONTROL CENTER (OCC) — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Backend Configuration
# Obtain from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Google Maps Platform API Key (Optional: Vector radar fallback active if unset)
# Requires Maps JavaScript API and Directions API enabled
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# Application Environment (development / staging / production)
VITE_APP_ENV=production

# Operations Control Parameters (Optional overrides)
VITE_OCC_CITY_NAME=Tumakuru
VITE_OCC_DEFAULT_LAT=13.3395
VITE_OCC_DEFAULT_LNG=77.1005
VITE_OCC_TELEMETRY_INTERVAL_MS=3000
